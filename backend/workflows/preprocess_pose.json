{
  "1": {"class_type": "LoadImage", "_meta": {"title": "Storyboard rough"}, "inputs": {"image": "{{image}}"}},
  "2": {"class_type": "DWPreprocessor", "_meta": {"title": "Pose (DWPose, OpenPose-format skeleton)"},
        "inputs": {"image": ["1", 0], "detect_hand": "enable", "detect_body": "enable", "detect_face": "enable",
                   "resolution": "{{resolution}}", "bbox_detector": "yolox_l.onnx",
                   "pose_estimator": "dw-ll_ucoco_384_bs5.torchscript.pt", "scale_stick_for_xinsr_cn": "enable"}},
  "3": {"class_type": "SaveImage", "inputs": {"filename_prefix": "{{filename_prefix}}", "images": ["2", 0]}}
}
