{
 "4": {
  "class_type": "CheckpointLoaderSimple",
  "_meta": {
   "title": "Load checkpoint (SDXL)"
  },
  "inputs": {
   "ckpt_name": "{{checkpoint}}"
  }
 },
 "20": {
  "class_type": "LoadImage",
  "_meta": {
   "title": "The current panel"
  },
  "inputs": {
   "image": "{{init_image}}"
  }
 },
 "21": {
  "class_type": "LoadImage",
  "_meta": {
   "title": "Mask (white = repaint)"
  },
  "inputs": {
   "image": "{{mask_image}}"
  }
 },
 "22": {
  "class_type": "ImageToMask",
  "inputs": {
   "image": [
    "21",
    0
   ],
   "channel": "red"
  }
 },
 "23": {
  "class_type": "GrowMask",
  "_meta": {
   "title": "Grow the mask a little so seams fall outside the edit"
  },
  "inputs": {
   "mask": [
    "22",
    0
   ],
   "expand": "{{mask_grow}}",
   "tapered_corners": true
  }
 },
 "27": {
  "class_type": "FeatherMask",
  "_meta": {
   "title": "Soft edge for pasting back"
  },
  "inputs": {
   "mask": [
    "23",
    0
   ],
   "left": "{{mask_feather}}",
   "top": "{{mask_feather}}",
   "right": "{{mask_feather}}",
   "bottom": "{{mask_feather}}"
  }
 },
 "24": {
  "class_type": "VAEEncode",
  "inputs": {
   "pixels": [
    "20",
    0
   ],
   "vae": [
    "4",
    2
   ]
  }
 },
 "25": {
  "class_type": "SetLatentNoiseMask",
  "_meta": {
   "title": "Only denoise inside the mask"
  },
  "inputs": {
   "samples": [
    "24",
    0
   ],
   "mask": [
    "23",
    0
   ]
  }
 },
 "6": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": "{{prompt}}",
   "clip": [
    "4",
    1
   ]
  }
 },
 "7": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": "{{negative_prompt}}",
   "clip": [
    "4",
    1
   ]
  }
 },
 "3": {
  "class_type": "KSampler",
  "inputs": {
   "seed": "{{seed}}",
   "steps": "{{steps}}",
   "cfg": "{{cfg}}",
   "sampler_name": "{{sampler}}",
   "scheduler": "{{scheduler}}",
   "denoise": "{{denoise}}",
   "model": [
    "12",
    0
   ],
   "positive": [
    "6",
    0
   ],
   "negative": [
    "7",
    0
   ],
   "latent_image": [
    "25",
    0
   ]
  }
 },
 "8": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "3",
    0
   ],
   "vae": [
    "4",
    2
   ]
  }
 },
 "26": {
  "class_type": "ImageCompositeMasked",
  "_meta": {
   "title": "Paste the new region onto the untouched panel"
  },
  "inputs": {
   "destination": [
    "20",
    0
   ],
   "source": [
    "8",
    0
   ],
   "x": 0,
   "y": 0,
   "resize_source": false,
   "mask": [
    "27",
    0
   ]
  }
 },
 "9": {
  "class_type": "SaveImage",
  "inputs": {
   "filename_prefix": "{{filename_prefix}}",
   "images": [
    "26",
    0
   ]
  }
 },
 "10": {
  "class_type": "IPAdapterUnifiedLoader",
  "_meta": {
   "title": "IP-Adapter + CLIP vision loader"
  },
  "inputs": {
   "model": [
    "4",
    0
   ],
   "preset": "{{ipadapter_preset}}"
  }
 },
 "11": {
  "class_type": "LoadImage",
  "_meta": {
   "title": "Character reference"
  },
  "inputs": {
   "image": "{{reference_image_1}}"
  }
 },
 "12": {
  "class_type": "IPAdapterAdvanced",
  "_meta": {
   "title": "Apply character reference"
  },
  "inputs": {
   "model": [
    "10",
    0
   ],
   "ipadapter": [
    "10",
    1
   ],
   "image": [
    "11",
    0
   ],
   "weight": "{{ipadapter_weight}}",
   "weight_type": "linear",
   "combine_embeds": "concat",
   "start_at": 0.0,
   "end_at": "{{ipadapter_end_at}}",
   "embeds_scaling": "V only"
  }
 }
}