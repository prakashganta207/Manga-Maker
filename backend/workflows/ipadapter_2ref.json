{
  "4": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "Load checkpoint (SDXL)"},
        "inputs": {"ckpt_name": "{{checkpoint}}"}},
  "10": {"class_type": "IPAdapterUnifiedLoader", "_meta": {"title": "IP-Adapter + CLIP vision loader"},
         "inputs": {"model": ["4", 0], "preset": "{{ipadapter_preset}}"}},
  "11": {"class_type": "LoadImage", "_meta": {"title": "Character A reference"},
         "inputs": {"image": "{{reference_image_1}}"}},
  "13": {"class_type": "LoadImage", "_meta": {"title": "Character B reference"},
         "inputs": {"image": "{{reference_image_2}}"}},
  "12": {"class_type": "IPAdapterAdvanced", "_meta": {"title": "Apply character A (reduced weight)"},
         "inputs": {"model": ["10", 0], "ipadapter": ["10", 1], "image": ["11", 0],
                    "weight": "{{ipadapter_weight_2}}", "weight_type": "linear", "combine_embeds": "concat",
                    "start_at": 0.0, "end_at": "{{ipadapter_end_at}}", "embeds_scaling": "V only"}},
  "14": {"class_type": "IPAdapterAdvanced", "_meta": {"title": "Apply character B (reduced weight)"},
         "inputs": {"model": ["12", 0], "ipadapter": ["10", 1], "image": ["13", 0],
                    "weight": "{{ipadapter_weight_2}}", "weight_type": "linear", "combine_embeds": "concat",
                    "start_at": 0.0, "end_at": "{{ipadapter_end_at}}", "embeds_scaling": "V only"}},
  "5": {"class_type": "EmptyLatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["4", 1]}},
  "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{negative_prompt}}", "clip": ["4", 1]}},
  "3": {"class_type": "KSampler", "inputs": {"seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
        "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}", "denoise": 1.0,
        "model": ["14", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]}},
  "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
  "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "{{filename_prefix}}", "images": ["8", 0]}}
}
