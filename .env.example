# Copy this file to .env and fill in what you need.
# With no keys at all, everything runs in MOCK mode (no AI calls, free, offline).

# --- Which providers to use ---------------------------------------------
# LLM_PROVIDER: auto = first configured of anthropic -> gemini -> openai -> mock
#               or force one: mock | anthropic | gemini | openai
# IMAGE_PROVIDER: auto = comfyui if reachable at COMFYUI_URL, else hosted, else mock
#               or force one: mock | comfyui | hosted
LLM_PROVIDER=auto
IMAGE_PROVIDER=auto

# --- LLMs (any ONE is enough) ---------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Any OpenAI-compatible server (OpenAI, Ollama, LM Studio, vLLM, OpenRouter, ...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional prices (USD per million tokens) for the per-job cost counter,
# for models the app doesn't know the price of.
LLM_INPUT_PRICE_PER_MTOK=
LLM_OUTPUT_PRICE_PER_MTOK=

# --- ComfyUI (local image generation) — see SETUP_COMFYUI.md ---------------
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=animagine-xl-3.1.safetensors
COMFYUI_STEPS=28
COMFYUI_CFG=6.0
COMFYUI_SAMPLER=euler_ancestral
COMFYUI_SCHEDULER=normal
COMFYUI_TIMEOUT=900
# Unload models between pipeline stages (keeps an 8 GB GPU happy)
COMFYUI_FREE_VRAM=true
# Optional folder with your own workflow templates (same file names as backend/workflows/)
COMFYUI_WORKFLOW_DIR=
# IP-Adapter: how strongly character reference images steer each panel (0..1)
IPADAPTER_WEIGHT=0.7
IPADAPTER_PRESET=PLUS (high strength)
IPADAPTER_END_AT=0.8

# --- Hosted image API (stub, fill in later) ------------------------------
HOSTED_IMAGE_API_URL=
HOSTED_IMAGE_API_KEY=

# --- App ------------------------------------------------------------------
OUTPUT_DIR=output
# Panels are generated at about IMAGE_BASE_SIZE² pixels in the panel's shape
# (1008 ≈ 832x1216, SDXL's portrait size). Lower to 896 if you run out of VRAM.
IMAGE_BASE_SIZE=1008
MAX_PAGES=2
MAX_PANELS_PER_PAGE=6
# Skip the cast approval step (unattended runs)
AUTO_APPROVE=false
# Character consistency score: auto (CLIP if torch+transformers installed) | clip | simple | off
CONSISTENCY_SCORER=auto
CLIP_MODEL=openai/clip-vit-base-patch32
# --- Editor agent + redraw loop (Phase 3) ----------------------------------
# A vision LLM grades every panel (9 criteria, 1-5). Failed panels are redrawn with its fixes.
EDITOR_ENABLED=true
EDITOR_MAX_ATTEMPTS=3
# combined = QUALITY_EDITOR_WEIGHT * editor score + (1 - weight) * CLIP score (both 0..1).
# Pass = combined >= QUALITY_THRESHOLD, no criterion <= QUALITY_MIN_CRITERION, Editor verdict "pass".
QUALITY_THRESHOLD=0.65
QUALITY_EDITOR_WEIGHT=0.7
QUALITY_MIN_CRITERION=2
# CLIP similarity is rescaled: CLIP_SCORE_LOW -> 0, CLIP_SCORE_HIGH -> 1
CLIP_SCORE_LOW=0.60
CLIP_SCORE_HIGH=0.90
# Per-job budgets: when one is used up, no more redraws (best attempt kept, "needs review")
JOB_MAX_LLM_CALLS=150
JOB_MAX_LLM_COST_USD=3.0
JOB_MAX_GPU_SECONDS=3600
# --- Storyboard + ControlNet (Phase 5) ------------------------------------
# A fast rough per panel -> pose skeleton (or line art) -> ControlNet keeps the final panel's layout.
STORYBOARD=auto
STORYBOARD_BASE_SIZE=768
STORYBOARD_STEPS=16
# auto = pose (DWPose), line art when no pose is found | openpose | lineart
STORYBOARD_CONTROL=auto
CONTROLNET_MODEL=controlnet-union-sdxl-1.0.safetensors
# 0.4-0.7 = a guide, 1.0 = copy the rough rigidly
CONTROLNET_STRENGTH=0.55
CONTROLNET_END=0.6

# --- Character LoRA training (Phase 5, optional, offline) — see CLOUD_TRAINING.md ---------
# auto = kohya-ss sd-scripts if installed in tools/sd-scripts, else a mock trainer (demo)
TRAINER=auto
SD_SCRIPTS_DIR=
SD_SCRIPTS_PYTHON=
# SDXL model file to train on (default: the ComfyUI checkpoint) and ComfyUI's models folder
LORA_BASE_MODEL=
COMFYUI_MODELS_DIR=
LORA_RESOLUTION=768
LORA_RANK=16
LORA_ALPHA=8
LORA_STEPS=600
LORA_LEARNING_RATE=0.0001
LORA_REPEATS=10
LORA_STRENGTH=0.8
IPADAPTER_WEIGHT_WITH_LORA=0.45

# --- Inpainting (Phase 4 editor) ----------------------------------------
# 1.0 = redraw the masked area from scratch; lower keeps more of what was there
INPAINT_DENOISE=0.9
INPAINT_GROW=12
INPAINT_FEATHER=10
# Lettering: the bundled Comic Neue (OFL) is used unless LETTERING_FONT points at another .ttf.
LETTERING_FONT=
# Vertical text (manga style columns): auto = only for Japanese/Chinese text | on | off
LETTERING_VERTICAL=auto
# Font for Japanese/Chinese text (the bundled fonts are Latin only); system fonts are tried otherwise
LETTERING_CJK_FONT=
# Frontend -> backend URL (used by Next.js in the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
