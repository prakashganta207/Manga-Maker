# Copy this file to .env and fill in what you need.
# With no keys at all, everything runs in MOCK mode (no AI calls, free, offline).

# --- Which providers to use ---------------------------------------------
# auto  = use the real provider if its key/URL below is set, otherwise mock
# mock  = always mock
# anthropic / comfyui / hosted = force that provider
LLM_PROVIDER=auto
IMAGE_PROVIDER=auto

# --- Anthropic Claude (story -> script) ----------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- ComfyUI (local image generation) ------------------------------------
# e.g. http://127.0.0.1:8188  (from Docker use http://host.docker.internal:8188)
COMFYUI_URL=
# Checkpoint file name as it appears in ComfyUI/models/checkpoints/
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
COMFYUI_STEPS=25
COMFYUI_CFG=6.5
COMFYUI_TIMEOUT=600

# --- Hosted image API (stub, fill in later) ------------------------------
HOSTED_IMAGE_API_URL=
HOSTED_IMAGE_API_KEY=

# --- App ------------------------------------------------------------------
OUTPUT_DIR=output
# Panels are generated at about IMAGE_BASE_SIZE x IMAGE_BASE_SIZE pixels, in the panel's shape.
# ~1024 suits SDXL checkpoints, ~512 suits SD 1.5.
IMAGE_BASE_SIZE=832
PANELS_PER_PAGE=4
MAX_PAGES=2
# Optional path to a .ttf font for lettering
LETTERING_FONT=
# Frontend -> backend URL (used by Next.js in the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
